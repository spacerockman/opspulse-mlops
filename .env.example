# ============================================================
# OpsPulse MLOps Environment Variables Template
# Copy to .env for local development. NEVER commit .env to Git!
# ============================================================

# --- General ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Target Business App Simulator ---
TARGET_APP_URL=http://localhost:8001

# --- Inference API ---
INFERENCE_API_URL=http://localhost:8002
# v0.1 uses "static_threshold". In Sprint 2 (Issue #11), switch to "mlflow_champion".
DETECTOR_BACKEND=static_threshold
MLFLOW_MODEL_NAME=opspulse-anomaly-detector
MLFLOW_MODEL_ALIAS=champion

# --- Object Storage (Local MinIO -> Prod AWS S3) [Sprint 1, Issue #1] ---
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=ap-northeast-1
S3_DATA_BUCKET=opspulse-data
S3_ARTIFACT_BUCKET=mlflow-artifacts

# --- PostgreSQL & MLflow [Sprint 1, Issue #1] ---
POSTGRES_USER=opspulse
POSTGRES_PASSWORD=opspulse_dev_pass
POSTGRES_DB=opspulse
MLFLOW_TRACKING_URI=http://localhost:5000

# --- LLMOps / SRE Triage Agent [Sprint 4, Issue #18-19] ---
# Supported options: gemini | openai | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# --- Langfuse Cloud (Free Tier) [Sprint 4, Issue #19] ---
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com
